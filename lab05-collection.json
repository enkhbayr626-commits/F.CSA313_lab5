{
  "info": {
    "name": "Lab05 — С. Энхбаяр B232270153",
    "description": "Үе шат 1: идэвхтэй оюутны амжилттай бүртгэл. Өөрийн setup PUT хүсэлтүүдтэй.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "TC01 — Урьдач нөхцөл хангасан идэвхтэй оюутан",
      "item": [
        {
          "name": "Setup — Идэвхтэй оюутан үүсгэх",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"coursesTaken\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/students/B232270153",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "B232270153"
              ]
            }
          }
        },
        {
          "name": "Setup — CS313 хичээл үүсгэх",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prerequisites\": [\n    \"CS201\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/courses/CS313",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "courses",
                "CS313"
              ]
            }
          }
        },
        {
          "name": "Идэвхтэй оюутан бүртгүүлэхэд 201 ба OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": \"B232270153\",\n  \"courseID\": \"CS313\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Амжилттай бүртгэлийн статус 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Амжилттай бүртгэлийн result OK\", function () {",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
